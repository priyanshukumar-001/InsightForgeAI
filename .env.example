# InsightForge AI - Environment Configuration Template
# Duplicate this file to .env to configure your local environment.
# Never commit your actual .env file with secrets into version control.

# Server Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
DATA_SERVICE_URL=http://127.0.0.1:8000
UPLOAD_DIR=private-uploads
STORAGE_DIR=storage-data
MAX_UPLOAD_MB=25

# Optional Database (Defaults automatically to local atomic JSON persistence)
MONGODB_URI=

# Multi-Provider AI Engine Configuration
# Supported providers: gemini | groq | openai | openrouter | demo
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=demo
AI_MODEL=gemini-2.5-flash

# Provider API Keys (Leave blank to use the Built-in Grounded Demo Copilot)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional Custom OpenAI-Compatible Base URL & Key
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# AI Execution Guards
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1500
